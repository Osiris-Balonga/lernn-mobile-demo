{
  "name": "lernn-mobile-demo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 7610 --strictPort",
    "generate:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "demo:sync-teacher-avatars": "node scripts/sync-teacher-avatars.mjs",
    "pretest": "pnpm generate:i18n",
    "build": "pnpm generate:i18n && tsr generate && tsc -b && vite build && node scripts/check-bundle-budget.mjs && node scripts/prepare-github-pages.mjs",
    "test": "node --test tests/demo-repository.test.mjs tests/demo-ui-contract.test.mjs tests/congo-demo-data.test.mjs tests/companion-field-workspace.test.mjs tests/student-normalizers.test.mjs tests/student-dashboard-query-state.test.mjs tests/parent-academic-access.test.mjs tests/parent-report-cards.test.mjs tests/no-document-previews.test.mjs tests/notification-overlay.test.mjs tests/login-error.test.mjs tests/card-login-payload.test.mjs tests/teacher-contracts.test.mjs tests/lazy-import.test.mjs tests/current-date.test.mjs tests/format.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "pnpm generate:i18n && tsr generate && tsc -b --force",
    "preview": "vite preview --host 0.0.0.0 --port 7610 --strictPort",
    "test:pages": "node scripts/prepare-github-pages.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-form": "^1.32.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.4",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.168.6",
    "@tanstack/store": "^0.11.0",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "flag-icons": "7.5.0",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@inlang/paraglide-js": "^2.18.0",
    "@tanstack/router-cli": "1.167.5",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1"
  }
}
